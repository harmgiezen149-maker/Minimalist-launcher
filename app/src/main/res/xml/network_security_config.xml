<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only. The one request the app makes
     (the temperature from api.open-meteo.com) never needs plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
